# Copy to deploy/.env and fill in. Never commit the real .env.

# Tailscale Funnel hostname of the server (without https://), e.g. booktribe.tail1234.ts.net
PUBLIC_HOST=booktribe.tailXXXX.ts.net

# Vercel URL of the frontend (with https://, without trailing slash)
FRONTEND_URL=https://booktribe.vercel.app

POSTGRES_USER=booktribe
POSTGRES_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-too
